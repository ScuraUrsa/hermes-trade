# HermesTrade Configuration

# --- Broker Settings ---
# Alpaca Markets (commission-free, US stocks)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# Interactive Brokers
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1

# XTB (Polish broker)
XTB_USERNAME=
XTB_PASSWORD=
XTB_DEMO=true

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- LLM / AI ---
# Ollama (local)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# Groq API (fast, free tier available)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# HuggingFace
HF_TOKEN=

# --- News & Social Media ---
# Twitter/X API
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Finnhub (free tier: 60 req/min)
FINNHUB_API_KEY=

# NewsAPI (free tier: 100 req/day)
NEWSAPI_KEY=

# --- Risk Limits ---
MAX_POSITION_SIZE=10000
MAX_DAILY_LOSS=1000
MAX_DRAWDOWN_PCT=20.0
MAX_TRADES_PER_DAY=50
STOP_LOSS_PCT=2.0
TAKE_PROFIT_PCT=5.0

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json
